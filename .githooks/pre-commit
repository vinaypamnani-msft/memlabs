#!/bin/sh

pwsh -NoLogo -NoProfile -NonInteractive -File vmbuild/tools/Test-StagedPowerShellSyntax.ps1
if [ $? -ne 0 ]; then
    echo "ERROR: Commit blocked by fast staged-file checks."
    exit 1
fi

pwsh -NoLogo -NoProfile -NonInteractive -File vmbuild/tools/Test-LocalizedBuiltInPrincipal.ps1 -Staged
if [ $? -ne 0 ]; then
    echo "ERROR: Commit blocked by localized built-in principal checks."
    exit 1
fi

exit 0
