{
  "cmOptions": {
    "version": "current-branch",
    "install": true,
    "pushClientToDomainMembers": true
  },
  "vmOptions": {
    "prefix": "PT2-",
    "basePath": "E:\\VirtualMachines",
    "domainName": "pstest2.com",
    "adminName": "admin",
    "network": "192.168.120.0",
    "timeZone": "Central Standard Time",
    "domainNetBiosName": "pstest2",
    "locale": "en-US"
  },
  "virtualMachines": [
    {
      "vmName": "DC1",
      "role": "DC",
      "operatingSystem": "Server 2022",
      "memory": "2GB",
      "virtualProcs": 4
    },
    {
      "vmName": "DPMP1",
      "role": "SiteSystem",
      "operatingSystem": "Server 2022",
      "additionalDisks": {
        "E": "250GB"
      },
      "memory": "3GB",
      "virtualProcs": 4,
      "siteCode": "PRI",
      "InstallMP": true,
      "InstallDP": true,
      "InstallRP": false,
      "InstallSUP": false
    },
    {
      "vmName": "PRISITE",
      "role": "Primary",
      "siteCode": "PRI",
      "operatingSystem": "Server 2022",
      "cmInstallDir": "E:\\ConfigMgr",
      "remoteSQLVM": "PRISQL",
      "additionalDisks": {
        "E": "250GB"
      },
      "memory": "8GB",
      "virtualProcs": 8,
      "InstallRP": false,
      "InstallSUP": false
    },
    {
      "vmName": "PRISQL",
      "role": "DomainMember",
      "operatingSystem": "Server 2019",
      "sqlVersion": "SQL Server 2017",
      "sqlInstanceName": "MSSQLSERVER",
      "sqlInstanceDir": "E:\\SQL",
      "additionalDisks": {
        "E": "250GB"
      },
      "memory": "8GB",
      "virtualProcs": 8,
      "sqlPort": "1433",
      "InstallRP": false
    },
    {
      "vmName": "W10Client1",
      "role": "DomainMember",
      "operatingSystem": "Windows 10 Latest (64-bit)",
      "memory": "2GB",
      "virtualProcs": 2
    },
    {
      "vmName": "W11Client2",
      "role": "DomainMember",
      "operatingSystem": "Windows 11 Latest",
      "memory": "4GB",
      "virtualProcs": 2
    }
  ]
}
